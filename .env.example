# Copy to `.env` on a machine if you like, then:
#   export $(grep -v '^#' .env | xargs)
# Do not commit `.env`. Never put tokens or passwords here.

# Code checkout (optional; inferred from the config file location if unset)
# RSRAG_PROJECT_ROOT=/content/remote-sensing-rag

# Real datasets (Google Drive example on Colab)
# RSRAG_UCM_ROOT=/content/drive/MyDrive/rsrag-data/ucm_captions
# RSRAG_RSITMD_ROOT=/content/drive/MyDrive/rsrag-data/rsitmd

# Write manifests/reports to Drive so Colab disconnects do not wipe them
# RSRAG_PROCESSED_DIR=/content/drive/MyDrive/rsrag-artifacts/processed
# RSRAG_REPORT_DIR=/content/drive/MyDrive/rsrag-artifacts/reports
